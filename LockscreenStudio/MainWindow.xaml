<Window x:Class="LockscreenStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lockscreen Studio" Height="760" Width="1180" MinHeight="650" MinWidth="980"
        Background="#111318">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#191C22" CornerRadius="18" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Lockscreen Studio" Foreground="White" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Windows lockscreen designer" Foreground="#AAB0BB" Margin="0,4,0,20" />

                    <TextBlock Text="Background" Foreground="White" FontWeight="SemiBold" />
                    <Button Content="Choose image" Click="ChooseBackground_Click" Margin="0,8,0,16" Padding="10" />

                    <CheckBox x:Name="ClockEnabled" Content="Show clock" IsChecked="True" Foreground="White" Margin="0,0,0,8" Checked="RefreshPreview" Unchecked="RefreshPreview" />
                    <CheckBox x:Name="DateEnabled" Content="Show date" IsChecked="True" Foreground="White" Margin="0,0,0,16" Checked="RefreshPreview" Unchecked="RefreshPreview" />

                    <TextBlock Text="Clock size" Foreground="White" />
                    <Slider x:Name="ClockSize" Minimum="36" Maximum="180" Value="92" ValueChanged="RefreshPreview" Margin="0,6,0,16" />

                    <TextBlock Text="Custom text" Foreground="White" />
                    <TextBox x:Name="CustomTextInput" Text="Make Windows yours." TextChanged="RefreshPreview" Margin="0,6,0,16" Padding="8" />

                    <TextBlock Text="Text size" Foreground="White" />
                    <Slider x:Name="TextSize" Minimum="16" Maximum="72" Value="28" ValueChanged="RefreshPreview" Margin="0,6,0,20" />

                    <Button Content="Export PNG" Click="Export_Click" Padding="12" Margin="0,0,0,8" />
                    <Button Content="Apply to lockscreen" Click="Apply_Click" Padding="12" />

                    <TextBlock x:Name="StatusText" Foreground="#AAB0BB" TextWrapping="Wrap" Margin="0,16,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Background="#191C22" CornerRadius="18" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Preview" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Border Grid.Row="1" Background="#0A0B0E" CornerRadius="14" Padding="14">
                    <Viewbox Stretch="Uniform">
                        <Grid x:Name="LockscreenCanvas" Width="1920" Height="1080" Background="#20242B">
                            <Image x:Name="BackgroundImage" Stretch="UniformToFill" />
                            <Border Background="#33000000" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="ClockText" Text="14:34" Foreground="White" FontSize="92" FontWeight="SemiBold" TextAlignment="Center" />
                                <TextBlock x:Name="DateText" Text="Saturday, 12 September" Foreground="White" FontSize="28" TextAlignment="Center" Margin="0,4,0,24" />
                                <TextBlock x:Name="CustomText" Text="Make Windows yours." Foreground="White" FontSize="28" TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Viewbox>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
