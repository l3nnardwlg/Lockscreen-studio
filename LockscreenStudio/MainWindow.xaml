<Window x:Class="LockscreenStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lockscreen Studio" Height="820" Width="1400" MinHeight="700" MinWidth="1100"
        Background="#111318">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#191C22" CornerRadius="18" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Lockscreen Studio" Foreground="White" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Modular Windows lockscreen designer" Foreground="#AAB0BB" Margin="0,4,0,20" />

                    <TextBlock Text="BACKGROUND" Foreground="#7F8794" FontSize="11" FontWeight="Bold" />
                    <Button Content="Choose image" Click="ChooseBackground_Click" Margin="0,8,0,22" Padding="10" />

                    <TextBlock Text="ADD MODULE" Foreground="#7F8794" FontSize="11" FontWeight="Bold" />
                    <UniformGrid Columns="2" Margin="0,8,0,8">
                        <Button Content="Clock" Tag="Clock" Click="AddModule_Click" Margin="0,0,6,6" Padding="10" />
                        <Button Content="Date" Tag="Date" Click="AddModule_Click" Margin="6,0,0,6" Padding="10" />
                        <Button Content="Text" Tag="Text" Click="AddModule_Click" Margin="0,6,6,0" Padding="10" />
                        <Button Content="Web" Tag="Web" Click="AddModule_Click" Margin="6,6,0,0" Padding="10" />
                    </UniformGrid>
                    <TextBlock Text="Drag modules directly on the preview to position them." Foreground="#8E96A3" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,22" />

                    <Border Background="#13161B" CornerRadius="12" Padding="14" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="SELECTED MODULE" Foreground="#7F8794" FontSize="11" FontWeight="Bold" />
                            <TextBlock x:Name="SelectedModuleTitle" Text="Nothing selected" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,12" />

                            <TextBlock Text="Text" Foreground="#B8BEC8" />
                            <TextBox x:Name="InspectorText" Margin="0,5,0,10" Padding="7" />

                            <TextBlock Text="Web URL" Foreground="#B8BEC8" />
                            <TextBox x:Name="InspectorUrl" Margin="0,5,0,10" Padding="7" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="X" Foreground="#B8BEC8" />
                                    <TextBox x:Name="InspectorX" Margin="0,5,0,0" Padding="7" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Y" Foreground="#B8BEC8" />
                                    <TextBox x:Name="InspectorY" Margin="0,5,0,0" Padding="7" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Width" Foreground="#B8BEC8" />
                                    <TextBox x:Name="InspectorWidth" Margin="0,5,0,0" Padding="7" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Height" Foreground="#B8BEC8" />
                                    <TextBox x:Name="InspectorHeight" Margin="0,5,0,0" Padding="7" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Font size" Foreground="#B8BEC8" />
                            <TextBox x:Name="InspectorFontSize" Margin="0,5,0,12" Padding="7" />

                            <Button Content="Apply properties" Click="ApplyInspector_Click" Padding="9" Margin="0,0,0,8" />
                            <Button Content="Delete module" Click="DeleteModule_Click" Padding="9" />
                        </StackPanel>
                    </Border>

                    <Button Content="Export PNG" Click="Export_Click" Padding="12" Margin="0,0,0,8" />
                    <Button Content="Apply to lockscreen" Click="Apply_Click" Padding="12" />
                    <TextBlock x:Name="StatusText" Foreground="#AAB0BB" TextWrapping="Wrap" Margin="0,16,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Background="#191C22" CornerRadius="18" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="Live Preview" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="1920 × 1080" Foreground="#7F8794" HorizontalAlignment="Right" />
                </DockPanel>

                <Border Grid.Row="1" Background="#0A0B0E" CornerRadius="14" Padding="14">
                    <Viewbox Stretch="Uniform">
                        <Grid x:Name="LockscreenCanvas" Width="1920" Height="1080" Background="#20242B" ClipToBounds="True">
                            <Image x:Name="BackgroundImage" Stretch="UniformToFill" />
                            <Border Background="#26000000" />
                            <Canvas x:Name="ModuleCanvas" Width="1920" Height="1080" Background="Transparent" />
                        </Grid>
                    </Viewbox>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
